# Production: exact HTTPS public origin, no trailing slash
APP_ORIGIN=https://reopen.example.com
PORT=4333
HOST=127.0.0.1
DATA_PATH=/var/lib/reopen/reopen.sqlite

# Optional: official authenticated Bee CLI proxy on the same trusted host.
# Export these variables before starting Node; .env files are not auto-loaded.
# Only this exact existing Reopen account ID may access the configured proxy.
# BEE_PROXY_URL=http://127.0.0.1:8787
# REOPEN_BEE_OWNER_ID=copy-from-Sources-setup
